# Copy this file to ".env" and fill in real values.

# --- Database (PostgreSQL) ---
# Either set a full connection string (takes precedence):
#   DATABASE_URL=postgres://user:pass@localhost:5432/toyxona
# or set the individual PG* vars below.
# Create the database once with:  createdb toyxona
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=toyxona

# --- Auth ---
# Secret used to sign JWTs. Set a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string

# --- Email / OTP ---
# Choose how OTP emails are sent. Leave as "auto" to pick automatically:
#   auto    -> SMTP if SMTP_USER+SMTP_PASS set, else Resend if key set, else console
#   smtp    -> force SMTP (e.g. Gmail app password)
#   resend  -> force Resend
#   console -> never send; print code to the server console (dev)
EMAIL_PROVIDER=auto

# "From" address shown to recipients.
# - For SMTP/Gmail: use your own address, e.g. "To‘yxona <youraddress@gmail.com>"
# - For Resend without a domain, the sandbox sender works: onboarding@resend.dev
OTP_FROM_EMAIL=To‘yxona <onboarding@resend.dev>

# --- Option 1: SMTP (e.g. Gmail with an App Password) ---
# Gmail: enable 2-Step Verification, then create an App Password:
#   https://myaccount.google.com/apppasswords
# Put that 16-char app password (NOT your normal password) in SMTP_PASS.
SMTP_SERVICE=gmail          # "gmail" shortcut; or leave empty and set SMTP_HOST/PORT below
SMTP_USER=                  # your full email address, e.g. you@gmail.com
SMTP_PASS=                  # 16-char Gmail App Password (no spaces)
# Generic SMTP (used only if SMTP_SERVICE is empty):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false           # true for port 465, false for 587

# --- Option 2: Resend (https://resend.com/api-keys) ---
# Note: with the sandbox sender (onboarding@resend.dev) Resend only delivers to
# YOUR OWN Resend account email. To email anyone, verify a domain at
# https://resend.com/domains and set OTP_FROM_EMAIL to that domain.
RESEND_API_KEY=

# --- OTP behaviour (optional, defaults shown) ---
OTP_TTL_MIN=5          # minutes a code stays valid
OTP_MAX_ATTEMPTS=5     # wrong tries before a code is invalidated
OTP_RESEND_SEC=60      # cooldown between sending codes

# --- Misc ---
# Set to "production" to stop dev OTP codes appearing in API responses.
NODE_ENV=development
